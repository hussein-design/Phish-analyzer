# Copy to .env for local development. Never commit the real .env file.
# These are first-run SEED values only -- once the app has started once,
# the live source of truth for both keys is the Settings dialog (stored in
# the app_settings DB row), not this file.

APP_HOST=127.0.0.1
APP_PORT=8756
LOG_LEVEL=INFO

VT_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=

# ── Phase 2: Behavioral Analysis ─────────────────────────────────────────────
# All settings are optional; the values below are the built-in defaults.
# You only need to set these if you want to override the defaults.

# Flag sender domains registered within this many days before the email was
# sent.  Lower = more sensitive (more false positives on legitimate new
# services).  Higher = less sensitive.  Default: 30 days.
# BEHAVIORAL_DOMAIN_AGE_THRESHOLD_DAYS=30

# Minimum number of prior emails from a (recipient, sender) pair before the
# send_time_anomaly signal can activate.  Below this threshold the signal
# always returns False to avoid false positives on thin data.  Default: 5.
# BEHAVIORAL_MIN_SEND_HISTORY=5

# Tolerance in whole hours around each historically-observed send hour.
# A send hour H is considered "normal" if the current send hour is within
# ±TOLERANCE of any hour in the sender's history (mod 24, so 23:00 and 01:00
# are 2 hours apart).  Set to 0 for exact-match only.  Default: 2.
# BEHAVIORAL_SEND_TIME_TOLERANCE_HOURS=2

# Hard cap on the number of send-hour samples stored per (recipient, sender)
# pair in the sender_history table.  When the cap is reached, the oldest
# entry is dropped (FIFO).  Prevents unbounded row growth for long-term
# senders.  Default: 200.
# BEHAVIORAL_MAX_SEND_HOURS=200

# ── Phase 3: BEC Detection ────────────────────────────────────────────────────
# All settings are optional; the values below are the built-in defaults.

# Minimum bec_score for the BEC "suspicious floor" to fire.
# When combined_score < 5 (formula says "benign") but bec_score >= this value,
# the verdict is forced up to "suspicious".
#
# Rationale for keeping this: BEC emails typically have zero static or dynamic
# signal (no bad URLs, no attachments, SPF/DKIM pass on the attacker's own
# domain). With the default 2× weight, a lone financial_request_language hit
# (bec_score=2) contributes 4 combined points — still benign by the formula.
# With two categories firing (bec_score=4, combined=8) the formula reaches
# "suspicious" on its own, so the floor is currently redundant at the default.
# It is kept as a forward-looking safety net: if signal weights are tuned down
# in the future (e.g. financial_per_category lowered to 1), the floor ensures
# that a bec_score >= 4 is never silently swallowed as benign regardless of the
# weight tuning. Set to 0 to disable it entirely.
# Default: 4.
# BEC_SUSPICIOUS_FLOOR=4

# Maximum points the financial_request_language signal can contribute to
# bec_score, regardless of how many of the five pattern categories match.
# Prevents a single verbose email from accumulating runaway BEC score purely
# from keyword density.  Each category contributes 2 pts; five categories
# would be 10 pts uncapped, so this cap (default 6) limits it to three
# categories' worth.  Raise if you want full five-category sensitivity.
# Default: 6.
# BEC_FINANCIAL_MAX_PTS=6
